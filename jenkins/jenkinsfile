pipeline {
    agent any
    stages {
        stage('unit test-frontend') {
            agent{
                 docker{
                      image 'node:20-alpine'
                      reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    // Fix: Clean up the broken root-owned files before installing dependencies
                    sh 'rm -rf node_modules package-lock.json'
                    sh '''
                    npm ci
                    npm test
                    '''
                }
            }
        }
        stage('unit test-backend') {
                    agent{
                         docker{
                              image 'snakee/golang-junit:1.21'
                               reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-backend') {
                            // Fix: Direct Go to a safe, wide-open write area for its cache
                            sh 'export GOCACHE=/tmp/.cache && go test -v ./...'
                        }
                    }

        }
    }
}
