pipeline {
    agent any
    stages {
        stage('unit test-frontend') {
            agent{
                 docker{
                      image 'node:20-alpine'
                      reuseNode true
                      // Keep this here for just one more run to ensure permissions stay clean
                      args '-u root'
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh '''
                    npm ci
                    npm test
                    '''
                }
            }
            post{
                always{
                   junit 'bugtracker-frontend/test-results.xml'
                }
            }
        }
        stage('unit test-backend') {
                    agent{
                         docker{
                              image 'snakee/golang-junit:1.21'
                               reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-backend') {
                            // Fix: Direct Go to a safe, wide-open write area for its cache
                            sh '''
                            export GOCACHE=/tmp/.cache
                            export GOMODCACHE=/tmp/.modcache
                            go test -v ./... 2>&1 | go-junit-report > test-results.xml
                            '''
                        }
                    }
                    post{
                        always{
                            junit 'bugtracker-backend/test-results.xml'
                        }
                    }

        }
    }
}
